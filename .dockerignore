# Keeps the Docker build context small and fast -- none of this is needed
# inside the backend image (Dockerfile does `COPY . .`).
.git
.github
.venv/
.venv_check/
venv/
env/
ENV/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Frontend has its own Dockerfile/.dockerignore; the backend image never
# needs the Node toolchain or its build output.
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Demo/docs assets aren't needed inside the running containers.
demo-media/
docs/
